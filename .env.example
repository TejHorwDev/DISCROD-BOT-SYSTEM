# ==============================================================
#  SELLER BOT - your private settings file
#
#  HOW TO USE: make a copy of this file and name it exactly
#              .env       (dot + env, no ".txt" at the end!)
#
#  SECURITY: Your bot tokens are like passwords.
#  NEVER share this file or your tokens with anyone.
#  If you think one leaked: Discord Developer Portal -> your app
#  -> Bot -> "Reset Token".
# ==============================================================

# ------------------------------------------------------------
# BOTS
# ------------------------------------------------------------
# The dashboard can drive SEVERAL bots at once (a Seller bot, a
# Messenger bot, ...). Manage them on the "Bots" page in the app:
# when you add a bot there, its token is written into THIS file
# automatically under a name like BOT_MESSENGER_TOKEN.
#
# This first key is the one the very first SELLER BOT used, and it
# stays supported forever - on first start it automatically becomes
# bot #1 ("SELLER BOT") in the app's bot list.
DISCORD_TOKEN=

# Example of what the app writes when you add more bots
# (you never need to type these by hand):
# BOT_MESSENGER_TOKEN=

# Optional: a channel ID used only by the "Send test" button,
# so you can preview a real listing before posting it to your store.
# How to get an ID: Discord Settings -> Advanced -> enable
# "Developer Mode", then right-click a channel -> "Copy Channel ID".
TEST_CHANNEL_ID=

# ------------------------------------------------------------
# ACCESS & AUTHENTICATION
# ------------------------------------------------------------
# Set to true when hosting online (e.g. on panel.fps.ms, Railway, or VPS)
# so the server listens on all network interfaces (0.0.0.0).
ALLOW_LAN=false

# Admin Login Credentials (protects your dashboard when hosted online)
ADMIN_EMAIL=admin@indra.gg
ADMIN_PASSWORD=indra2026!
SECRET_KEY=indra_bot_secret_key_change_me_to_random_string

# Optional: port to run on (default 5000)
# PORT=5000
